# Root .gitignore for HelixSign Monorepo

# Do not commit raw frontend template / zip as requested
frontend.zip
frontend/

# OS and Editor metadata
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Environment and Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Node / JavaScript
node_modules/
.pnpm-store/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & ML
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.pt
*.pth
*.bin
*.onnx
*.pkl
*.joblib
*.tar.gz
*.h5
.ipynb_checkpoints/
ml/data/raw/
ml/artifacts/*.pt
ml/artifacts/*.onnx
ml/artifacts/*.bin

