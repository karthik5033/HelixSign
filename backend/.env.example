# HelixSign Backend Configuration
PORT=3001
NODE_ENV=development

# Security & Master Secrets (Never commit actual keys)
MASTER_KEY=your_32_byte_hex_encoded_master_key_here

# Supabase Registry Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# ML Microservice Bridge
USE_STUBS=true
ML_SERVICE_URL=http://127.0.0.1:8000

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
